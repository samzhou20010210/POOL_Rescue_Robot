<?xml version="1.0"?>
<!--
  V4 ROV for the Gazebo backend of sim_nav.launch.py (backend:=gazebo).

  Planar kinematic model: VelocityControl applies the commanded body-frame
  velocity (linear x/y, angular z) directly, so there is no hydrodynamics,
  thruster model, or buoyancy yet. The world has zero gravity, so the ROV
  holds its depth (treated as neutrally buoyant).

  OdometryPublisher reports the model's actual pose in the Gazebo world
  frame, named "odom" here, as odometry and as the odom -> base_link
  transform (same timestamp for both). ros_gz_bridge forwards them to ROS.

  The mesh comes from the installed rov_description package
  (model:// is resolved through GZ_SIM_RESOURCE_PATH, set by the launch file).
-->
<sdf version="1.9">
  <model name="rov_v4">
    <link name="base_link">
      <!-- Placeholder mass and inertia (box 1.0 x 1.04 x 0.3 m, 50 kg).
           Real values are still unknown; they do not affect the
           velocity-controlled motion. -->
      <inertial>
        <mass>50.0</mass>
        <inertia>
          <ixx>4.88</ixx><iyy>4.54</iyy><izz>8.67</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="hull">
        <geometry>
          <mesh>
            <uri>model://rov_description/meshes/ROV_V4.STL</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.6 0.6 0.6 1</ambient>
          <diffuse>0.6 0.6 0.6 1</diffuse>
        </material>
      </visual>
      <!-- Simple bounding box of the assembly, so the ROV cannot pass
           through the pool walls. -->
      <collision name="hull_box">
        <geometry><box><size>1.0 1.04 0.3</size></box></geometry>
      </collision>
    </link>

    <!-- Planar velocity commands (gz.msgs.Twist, body frame). -->
    <plugin filename="gz-sim-velocity-control-system"
            name="gz::sim::systems::VelocityControl">
      <topic>/model/rov_v4/cmd_vel</topic>
    </plugin>

    <!-- Actual model motion fed back as odometry and TF. -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/model/rov_v4/odometry</odom_topic>
      <tf_topic>/model/rov_v4/odometry_tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>
